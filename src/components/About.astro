---
import { getCollection } from "astro:content";
import SectionHeader from "@components/SectionHeader.astro";

const skillsData = await getCollection("skills");
const sortedSkills = skillsData.sort((a, b) => a.data.order - b.data.order);

// Split skills into 3 columns
const skillsPerColumn = Math.ceil(sortedSkills.length / 3);
const columns = [
  sortedSkills.slice(0, skillsPerColumn),
  sortedSkills.slice(skillsPerColumn, skillsPerColumn * 2),
  sortedSkills.slice(skillsPerColumn * 2),
];
---

<section id="about" class="section-spacing" aria-labelledby="about-heading">
  <div class="container mx-auto max-w-5xl px-6">
    <SectionHeader
      command="cat skills"
      title="Mis"
      highlight="Skills"
      description="Stack tecnológico que utilizo para desarrollar soluciones web performantes y escalables."
      neonColor="purple"
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
      {
        columns.map((columnSkills, colIndex) => (
          <div class="space-y-6">
            {columnSkills.map((skill, idx) => (
              <div class="space-y-2">
                <div class="text-muted font-mono text-xs">
                  <span class="text-primary">$</span> skills --
                  {skill.data.category.toLowerCase().replace(/\s+/g, "-")}
                </div>
                <div class="space-y-1">
                  {skill.data.items.map((item) => (
                    <div class="text-foreground font-mono text-sm">
                      <span class="text-primary">→</span> {item.name}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

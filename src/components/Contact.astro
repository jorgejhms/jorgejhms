---
import Button from "./Button.astro";
import { getCollection } from "astro:content";

const siteData = (await getCollection("site"))[0].data;

const contacts = [
  {
    label: "Email",
    href: `mailto:${siteData.email}`,
    display: siteData.email,
    icon: "mail",
    description: "Para proyectos y colaboraciones",
  },
  {
    label: "GitHub",
    href: siteData.socials.github.url,
    display: siteData.socials.github.display,
    icon: "github",
    description: "Código y proyectos open source",
  },
  {
    label: "LinkedIn",
    href: siteData.socials.linkedin.url,
    display: siteData.socials.linkedin.display,
    icon: "linkedin",
    description: "Conexiones profesionales",
  },
];

const availability = siteData.availability;
---

<section id="contact" class="section-spacing" aria-labelledby="contact-heading">
  <div class="container mx-auto px-6">
    <!-- Section Header -->
    <div class="mb-12 flex flex-col gap-6">
      <div class="text-muted font-mono text-sm">
        <span class="text-primary">$</span> contact --init
      </div>

      <h2
        id="contact-heading"
        class="font-mono text-3xl font-bold md:text-4xl lg:text-5xl"
      >
        <span class="text-foreground">{">"} Hablemos de </span>
        <span class="neon-text-pink">tu proyecto</span>
      </h2>

      <p
        class="text-foreground/80 max-w-2xl text-base leading-relaxed md:text-lg"
      >
        ¿Buscas colaboración en proyectos, consultoría técnica o mentoring?
        {siteData.availability.responseText}
      </p>
    </div>

    <div class="grid items-start gap-12 lg:grid-cols-2">
      <!-- Contact Information -->
      <div class="space-y-8">
        <!-- Availability Status -->
        <div
          class="bg-surface border-border hover:bg-elevated/50 rounded-lg border p-6 transition-colors"
        >
          <div class="mb-4 flex items-center gap-3">
            <div class="flex items-center gap-2 font-mono text-sm">
              <span
                class={`h-2 w-2 rounded-full ${
                  availability.status === "available"
                    ? "bg-success animate-pulse"
                    : "bg-warning"
                }`}></span>
              <span class="text-success font-medium">
                {availability.message}
              </span>
            </div>
          </div>
          <div class="text-muted font-mono text-xs">
            <span class="text-primary">$</span> response_time: {
              availability.responseTime
            }
          </div>
        </div>

        <!-- Contact Methods -->
        <div class="space-y-4">
          <div class="text-muted mb-6 font-mono text-sm">
            <span class="text-primary">$</span> contact --list
          </div>

          {
            contacts.map(({ label, href, display, icon, description }) => (
              <a
                href={href}
                target={href.startsWith("mailto:") ? "_self" : "_blank"}
                rel={
                  href.startsWith("mailto:") ? undefined : "noopener noreferrer"
                }
                class="group bg-surface border-border hover:bg-elevated hover:border-primary/50 card-hover block rounded-lg border p-6 transition-all duration-300"
              >
                <div class="flex items-start gap-4">
                  <div class="bg-primary/10 group-hover:bg-primary/20 flex-shrink-0 rounded-md p-2 transition-colors">
                    {icon === "mail" && (
                      <svg
                        class="text-primary h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        />
                      </svg>
                    )}
                    {icon === "github" && (
                      <svg
                        class="text-primary h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                    )}
                    {icon === "linkedin" && (
                      <svg
                        class="text-primary h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                      </svg>
                    )}
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="mb-2 flex items-center gap-2">
                      <h3 class="text-foreground group-hover:text-primary font-mono text-lg font-semibold transition-colors">
                        {label}
                      </h3>
                      <svg
                        class="text-muted group-hover:text-primary h-4 w-4 transition-all group-hover:translate-x-1"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </div>

                    <p class="text-secondary mb-2 font-mono text-sm break-all">
                      {display}
                    </p>

                    <p class="text-muted text-sm">{description}</p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Call to Action -->
      <div class="space-y-8">
        <!-- Featured CTA -->
        <div class="bg-gradient-accent rounded-lg p-8 text-center">
          <div class="mb-6">
            <div class="text-background/80 mb-2 font-mono text-sm">
              $ quick_start --now
            </div>
            <h3 class="text-background mb-4 font-mono text-2xl font-bold">
              ¿Listo para empezar?
            </h3>
            <p class="text-background/80 leading-relaxed">
              Envíame un mensaje y conversemos sobre cómo puedo ayudarte a hacer
              realidad tu proyecto.
            </p>
          </div>

          <Button
            href={`mailto:${siteData.email}`}
            variant="secondary"
            size="lg"
            class="bg-background text-primary hover:bg-background/90 group"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Enviar mensaje
            <svg
              class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </Button>
        </div>

        <!-- Additional Info -->
        <div class="bg-surface border-border rounded-lg border p-6">
          <h4 class="text-foreground mb-4 font-mono text-lg font-semibold">
            ¿En qué puedo ayudarte?
          </h4>

          <ul class="text-foreground/80 space-y-3 text-sm">
            {
              siteData.services.map((service, index) => {
                const colors = [
                  "bg-primary",
                  "bg-secondary",
                  "bg-accent",
                  "bg-warning",
                ];
                return (
                  <li class="flex items-start gap-3">
                    <span
                      class={`h-1.5 w-1.5 rounded-full ${colors[index % colors.length]} mt-2 flex-shrink-0`}
                    />
                    <span>{service.title}</span>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <!-- Terminal Footer -->
        <div
          class="text-muted/60 bg-elevated/30 rounded-md p-4 font-mono text-xs"
        >
          <div class="mb-2">
            <span class="text-primary">$</span> status --contact
          </div>
          <div class="space-y-1">
            <div>
              <span class="text-success">✓</span> Contact methods loaded
            </div>
            <div>
              <span class="text-success">✓</span> Available for new projects
            </div>
            <div>
              <span class="text-success">✓</span> Response time: {
                availability.responseTime
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pulse animation for availability indicator */
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>

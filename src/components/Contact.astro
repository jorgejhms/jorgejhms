---
import Button from "@components/Button.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { getCollection } from "astro:content";

const siteData = (await getCollection("site"))[0].data;

const contacts = [
  {
    label: "Email",
    href: `mailto:${siteData.email}`,
    iconType: "mail",
  },
  {
    label: "GitHub",
    href: siteData.socials.github.url,
    iconType: "github",
  },
  {
    label: "LinkedIn",
    href: siteData.socials.linkedin.url,
    iconType: "linkedin",
  },
];

const availability = siteData.availability;
---

<section id="contact" class="section-spacing" aria-labelledby="contact-heading">
  <div class="container mx-auto max-w-5xl px-6">
    <SectionHeader
      command="contact --init"
      title="Hablemos de"
      highlight="tu proyecto"
      description=""
      neonColor="pink"
    />

    <!-- Simplified single-column centered layout -->
    <div class="mx-auto max-w-xl text-center">
      <!-- Integrated availability as subtle inline badge -->
      <div class="mb-6 inline-flex items-center gap-2 font-mono text-sm">
        <span
          class:list={[
            "h-2 w-2 rounded-full",
            {
              "bg-success animate-pulse": availability.status === "available",
              "bg-warning": availability.status !== "available",
            },
          ]}></span>
        <span class="text-success">{availability.message}</span>
        <span class="text-muted text-xs">· {availability.responseTime}</span>
      </div>

      <!-- CTA description -->
      <p class="text-foreground/70 mb-8 text-lg leading-relaxed">
        Envíame un mensaje y conversemos sobre cómo puedo ayudarte a hacer
        realidad tu proyecto.
      </p>

      <!-- Primary CTA Button -->
      <Button
        href={`mailto:${siteData.email}`}
        variant="primary"
        size="lg"
        class="group mb-10"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        Enviar mensaje
        <svg
          class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </Button>

      <!-- Simplified social links - subtle, horizontal -->
      <div class="flex items-center justify-center gap-6">
        {
          contacts.map(({ label, href, iconType }) => (
            <a
              href={href}
              target={href.startsWith("mailto:") ? "_self" : "_blank"}
              rel={
                href.startsWith("mailto:") ? undefined : "noopener noreferrer"
              }
              class="text-muted hover:text-primary transition-colors"
              aria-label={label}
            >
              {iconType === "mail" && (
                <svg
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              )}
              {iconType === "github" && (
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd"
                  />
                </svg>
              )}
              {iconType === "linkedin" && (
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

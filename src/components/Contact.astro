---
import Button from "./Button.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCollection } from "astro:content";

const siteData = (await getCollection("site"))[0].data;

const contacts = [
  {
    label: "Email",
    href: `mailto:${siteData.email}`,
    display: siteData.email,
    icon: "mail",
    description: "Para proyectos y colaboraciones",
  },
  {
    label: "GitHub",
    href: siteData.socials.github.url,
    display: siteData.socials.github.display,
    icon: "github",
    description: "Código y proyectos open source",
  },
  {
    label: "LinkedIn",
    href: siteData.socials.linkedin.url,
    display: siteData.socials.linkedin.display,
    icon: "linkedin",
    description: "Conexiones profesionales",
  },
];

const availability = siteData.availability;
---

<section id="contact" class="section-spacing" aria-labelledby="contact-heading">
  <div class="container mx-auto px-6">
    <SectionHeader
      command="contact --init"
      title="Hablemos de"
      highlight="tu proyecto"
      description={`¿Buscas colaboración en proyectos, consultoría técnica o mentoring? ${siteData.availability.responseText}`}
      neonColor="pink"
    />

    <div class="grid items-start gap-12 lg:grid-cols-2">
      <!-- Contact Information -->
      <div class="space-y-8">
        <!-- Availability Status -->
        <div
          class="bg-surface border-border hover:bg-elevated/50 rounded-lg border p-6 transition-colors"
        >
          <div class="flex items-center gap-2 font-mono text-sm">
            <span
              class={`h-2 w-2 rounded-full ${
                availability.status === "available"
                  ? "bg-success animate-pulse"
                  : "bg-warning"
              }`}></span>
            <span class="text-success font-medium">
              {availability.message}
            </span>
            <span class="text-muted text-xs">({availability.responseTime})</span>
          </div>
        </div>

        <!-- Contact Methods with Connection Lines -->
        <div class="space-y-2 font-mono text-sm">
          <div class="text-muted mb-6">
            <span class="text-primary">$</span> contact --list
          </div>

          {
            contacts.map(({ label, href, display, icon, description }, index) => (
              <a
                href={href}
                target={href.startsWith("mailto:") ? "_self" : "_blank"}
                rel={
                  href.startsWith("mailto:") ? undefined : "noopener noreferrer"
                }
                class="connection-point hover:text-primary transition-colors"
              >
                <div class="flex-1">
                  <div class="text-foreground font-semibold">{label}</div>
                  <div class="text-muted text-xs break-all">{display}</div>
                  <div class="text-muted/70 text-xs mt-1">{description}</div>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Call to Action -->
      <div class="space-y-12">
        <!-- Featured CTA - Flat design -->
        <div class="text-center">
          <h3 class="text-foreground mb-4 font-mono text-2xl font-bold">
            ¿Listo para empezar?
          </h3>
          <p class="text-foreground/70 leading-relaxed mb-6">
            Envíame un mensaje y conversemos sobre cómo puedo ayudarte a hacer
            realidad tu proyecto.
          </p>

          <Button
            href={`mailto:${siteData.email}`}
            variant="primary"
            size="lg"
            class="group"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Enviar mensaje
            <svg
              class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </Button>
        </div>

        <!-- Services Info - Minimal list -->
        <div>
          <h4 class="text-foreground mb-4 font-mono text-sm font-semibold">
            $ services --available
          </h4>

          <ul class="text-foreground/80 space-y-2 text-xs font-mono">
            {
              siteData.services.map((service) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary">→</span>
                  <span>{service.title}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

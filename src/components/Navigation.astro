---
import { getCollection } from "astro:content";

// Explicitly type the collection query or cast the result if needed,
// though Astro's content layer should handle this if types are generated.
// We'll use a safer access pattern.
const siteCollection = await getCollection("site");
const siteData = siteCollection[0]?.data;

if (!siteData) {
  throw new Error("Site configuration not found in content/site/");
}

const links = siteData.navLinks;
const socialLinks = [
  {
    href: siteData.socials.github.url,
    label: "GitHub",
    icon: "github",
  },
  {
    href: siteData.socials.linkedin.url,
    label: "LinkedIn",
    icon: "linkedin",
  },
];
---


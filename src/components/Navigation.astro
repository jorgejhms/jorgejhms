        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="bg-background/60 border-border fixed inset-x-0 top-0 -translate-y-[150%] transform rounded-b-lg border-x border-b backdrop-blur-xl transition-transform duration-300 ease-in-out md:hidden"
>
  <div class="space-y-4 px-6 pt-20 pb-6">
    <!-- Commented: Hide mobile navigation links -->
    <!-- <nav class="space-y-4"> -->
    <!--   { -->
    <!--     links.map(({ href, label }: { href: string; label: string }) => ( -->
    <!--       <a -->
    <!--         href={href} -->
    <!--         class="text-foreground/80 hover:text-primary mobile-link block py-2 font-mono transition-colors" -->
    <!--       > -->
    <!--         <span class="text-comment">$ </span> -->
    <!--         {label} -->
    <!--       </a> -->
    <!--     )) -->
    <!--   } -->
    <!-- </nav> -->

    <!-- Mobile Social Links -->
    <div class="border-border border-t pt-4">
      <div class="text-muted mb-2 font-mono text-sm">
        <span class="text-primary">$</span> social --connect
      </div>
      <div class="flex gap-4">
        {
          socialLinks.map(({ href, label, icon }) => (
            <a

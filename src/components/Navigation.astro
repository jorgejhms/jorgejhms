      class="text-primary hover:text-secondary group font-mono text-lg font-semibold transition-colors"
      aria-label={`${siteData.name} - Inicio`}
    >
      <span class="text-foreground">{">"}</span>
      <span class="neon-text-cyan">{siteData.username}</span>
      <span
        class="text-muted opacity-0 transition-opacity group-hover:opacity-100"
        >_</span
      >
    </a>

    <!-- Desktop Navigation -->
    <!-- Commented: Hide subpage navigation links -->
    <!-- <div class="hidden items-center gap-8 md:flex"> -->
    <!--   <ul class="flex items-center gap-6 font-mono text-sm"> -->
    <!--     { -->
    <!--       links.map(({ href, label }: { href: string; label: string }) => ( -->
    <!--         <li> -->
    <!--           <a -->
    <!--             href={href} -->
    <!--             class="text-foreground/80 hover:text-primary group relative transition-all duration-300" -->
    <!--           > -->
    <!--             <span class="text-comment">// </span> -->
    <!--             {label} -->
    <!--             <span class="bg-primary absolute -bottom-1 left-0 h-0.5 w-0 transition-all duration-300 group-hover:w-full" /> -->
    <!--           </a> -->
    <!--         </li> -->
    <!--       )) -->
    <!--     } -->
    <!--   </ul> -->

    <!-- Social Links remain visible -->
    <div class="border-border hidden items-center gap-3 border-l pl-6 md:flex">
      {

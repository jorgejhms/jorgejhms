---
import type { CollectionEntry } from "astro:content";
import Button from "./Button.astro";

export interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;

const badgeColors = [
  "neon-border-green bg-primary/10 text-primary",
  "neon-border-purple bg-secondary/10 text-secondary",
  "neon-border-cyan bg-accent/10 text-accent",
  "bg-warning/10 text-warning border border-warning/30",
  "bg-danger/10 text-danger border border-danger/30",
];

const slug = project.id;
---

<article
  class="group bg-surface border-border hover:bg-elevated hover:border-primary/50 card-hover relative h-full rounded-lg border p-6 transition-all duration-300"
>
  <!-- Featured badge -->
  {
    data.featured && (
      <div class="absolute -top-2 -right-2 z-10">
        <div class="bg-primary text-background rounded-full px-2 py-1 font-mono text-xs font-medium">
          Featured
        </div>
      </div>
    )
  }

  <!-- Project Image (if available) -->
  {
    data.image && (
      <div class="bg-elevated/50 relative mb-4 overflow-hidden rounded-md">
        <img
          src={data.image}
          alt={`Screenshot of ${data.title}`}
          class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
        <div class="from-background/60 absolute inset-0 bg-gradient-to-t to-transparent" />
      </div>
    )
  }

  <!-- Project Header -->
  <header class="mb-4">
    <h3
      class="text-foreground group-hover:text-primary mb-2 font-mono text-xl font-semibold transition-colors"
    >
      {data.title}
    </h3>

    <div class="text-muted mb-3 font-mono text-xs">
      <span class="text-comment">// </span>
      <span>Project #{String(data.order).padStart(2, "0")}</span>
    </div>
  </header>

  <!-- Description -->
  <div class="mb-6 flex-1">
    <p class="text-foreground/80 text-sm leading-relaxed md:text-base">
      {data.description}
    </p>
  </div>

  <!-- Technologies -->
  <div class="mb-6">
    <div class="text-muted mb-3 font-mono text-xs">
      <span class="text-primary">$</span> stack --list
    </div>
    <ul class="flex flex-wrap gap-2 font-mono text-xs">
      {
        data.technologies.map((tech, index) => (
          <li
            class={`rounded-full px-3 py-1.5 transition-all duration-200 hover:scale-105 ${badgeColors[index % badgeColors.length]}`}
          >
            {tech}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Action Buttons -->
  <footer
    class="border-border/50 flex flex-col gap-3 border-t pt-4 sm:flex-row"
  >
    <div class="flex flex-1 gap-3">
      {
        data.liveUrl && (
          <Button
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="sm"
            class="group/btn flex-1"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Demo
          </Button>
        )
      }

      {
        data.githubUrl && (
          <Button
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="sm"
            class="flex-1"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            Código
          </Button>
        )
      }
    </div>

    <!-- Project detail link -->
    <Button
      href={`/experience/${slug}`}
      variant="ghost"
      size="sm"
      class="text-muted hover:text-primary"
    >
      <span class="font-mono">readme.md</span>
      <svg
        class="ml-1 h-3 w-3 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </Button>
  </footer>

  <!-- Terminal output indicator -->
  <div class="text-muted/30 absolute right-2 bottom-2 font-mono text-xs">
    <span class="text-success">●</span>
  </div>
</article>

<style>
  /* Custom hover effects for the card */
  .card-hover:hover {
    box-shadow: 0 8px 25px rgba(80, 250, 123, 0.15);
  }

  /* Subtle glow effect on hover */
  .card-hover:hover .neon-border-green {
    box-shadow: 0 0 10px rgba(80, 250, 123, 0.3);
  }

  .card-hover:hover .neon-border-purple {
    box-shadow: 0 0 10px rgba(189, 147, 249, 0.3);
  }

  .card-hover:hover .neon-border-cyan {
    box-shadow: 0 0 10px rgba(139, 233, 253, 0.3);
  }
</style>

---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import SectionHeader from "./SectionHeader.astro";

const projects = await getCollection("projects");
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<section
  id="projects"
  class="section-spacing relative"
  aria-labelledby="projects-heading"
>
  <div class="container mx-auto px-6 md:px-12">
    <SectionHeader
      command="ls projects --featured"
      title="Mis"
      highlight="Proyectos"
      description="Experimentación con frameworks modernos, flujos de datos y diseño accesible orientado a performance. Cada proyecto está documentado con foco en arquitectura y tooling."
    />

    <!-- Featured Projects Stack -->
    <div class="mt-16 flex flex-col gap-24 md:gap-32">
      {
        featuredProjects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))
      }

      <!-- Show All Projects Link (treated as a final item in the flow) -->
      {
        allProjects.length > featuredProjects.length && (
          <div class="group flex flex-col items-start justify-center py-12 md:py-24">
            <a
              href="/projects"
              class="flex items-center gap-6 text-2xl font-bold md:text-5xl"
            >
              <span class="text-muted group-hover:text-primary transition-colors duration-300">
                Ver todos los proyectos
              </span>
              <span class="text-primary group-hover:translate-x-4 transition-transform duration-300">
                →
              </span>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

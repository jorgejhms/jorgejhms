---
import SectionHeader from "./SectionHeader.astro";

interface Testimonial {
  name: string;
  company: string;
  role: string;
  quote: string;
  image?: string;
}

const testimonials: Testimonial[] = [
  {
    name: "Cliente Placeholder 1",
    company: "Empresa Ejemplo",
    role: "CEO / Founder",
    quote:
      "Testimonio placeholder: Describa cómo Jorge ayudó a su empresa. Mencione el impacto técnico y de negocio.",
    image: "/testimonials/placeholder-1.jpg",
  },
  {
    name: "Cliente Placeholder 2",
    company: "Startup Tech",
    role: "CTO",
    quote:
      "Testimonio placeholder: Explique la calidad del trabajo, la comunicación, y resultados entregados.",
    image: "/testimonials/placeholder-2.jpg",
  },
  {
    name: "Cliente Placeholder 3",
    company: "Agencia Digital",
    role: "Project Manager",
    quote:
      "Testimonio placeholder: Destaque habilidades técnicas, atención al detalle, y capacidad de resolver problemas.",
    image: "/testimonials/placeholder-3.jpg",
  },
];
---

<section class="section-spacing" id="testimonials">
  <div class="container mx-auto max-w-5xl px-6">
    <SectionHeader
      command="cat testimonials"
      title=""
      highlight="Testimonios"
      description="Qué dicen mis clientes sobre el trabajo"
      neonColor="cyan"
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((testimonial) => (
          <div class="group border-primary/40 bg-surface hover:border-primary/60 hover:shadow-primary/20 relative overflow-hidden rounded-lg border transition-all hover:shadow-lg">
            {/* Top accent line */}
            <div class="bg-primary h-1 w-0 transition-all group-hover:w-full" />

            <div class="flex h-full flex-col p-6">
              {/* Author info */}
              <div class="border-primary/20 mb-4 flex items-center gap-3 border-b pb-4">
                {testimonial.image && (
                  <img
                    src={testimonial.image}
                    alt={testimonial.name}
                    class="from-primary to-accent h-12 w-12 flex-shrink-0 rounded-full bg-gradient-to-br"
                  />
                )}
                <div class="min-w-0">
                  <p class="text-foreground font-mono text-sm leading-tight font-bold">
                    {testimonial.name}
                  </p>
                  <p class="text-muted text-xs leading-tight">
                    {testimonial.role}
                  </p>
                  <p class="text-muted/70 text-xs leading-tight">
                    {testimonial.company}
                  </p>
                </div>
              </div>

              {/* Quote text */}
              <p class="text-foreground/80 flex-1 text-sm leading-relaxed">
                "{testimonial.quote}"
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

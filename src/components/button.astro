---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "outline" | "ghost" | "link";
  size?: "sm" | "md" | "lg";
  class?: string;
  [key: string]: any;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  class: className,
  ...rest
} = Astro.props;

const variants = {
  primary:
    "bg-primary/10 text-primary border border-primary/50 hover:bg-primary/20 hover:border-primary hover:shadow-neon-green neon-border-hover",
  secondary:
    "bg-elevated text-foreground border border-border hover:bg-elevated/80 hover:text-primary",
  outline:
    "bg-transparent border-border text-foreground hover:bg-elevated hover:text-primary",
  ghost:
    "bg-transparent text-foreground hover:bg-elevated/50 hover:text-primary",
  link: "text-primary underline-offset-4 hover:underline p-0 h-auto",
};

const sizes = {
  sm: "h-8 px-3 text-xs",
  md: "h-10 px-4 py-2 text-sm",
  lg: "h-12 px-8 text-base",
};

const baseStyles =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-mono font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border";

const classes = [baseStyles, variants[variant], sizes[size], className].join(
  " ",
);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}

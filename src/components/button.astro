---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "outline" | "ghost" | "link";
  size?: "sm" | "md" | "lg";
  class?: string;
  [key: string]: any;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  class: className,
  ...rest
} = Astro.props;

const variants = {
  primary:
    "bg-primary text-background hover:bg-primary/90 shadow-[0_0_10px_rgba(80,250,123,0.3)] hover:shadow-[0_0_20px_rgba(80,250,123,0.5)] border-transparent",
  outline:
    "bg-transparent border-primary text-primary hover:bg-primary/10 shadow-[0_0_5px_rgba(80,250,123,0.2)]",
  ghost: "bg-transparent text-foreground hover:bg-elevated/50 hover:text-primary",
  link: "text-primary underline-offset-4 hover:underline p-0 h-auto",
};

const sizes = {
  sm: "h-8 px-3 text-xs",
  md: "h-10 px-4 py-2 text-sm",
  lg: "h-12 px-8 text-base",
};

const baseStyles =
  "inline-flex items-center justify-center whitespace-nowrap rounded-md font-mono font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border";

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  className,
].join(" ");
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}

---
import Tag from "../components/tag.astro";
const {
  title = "Título",
  tags = ["?"],
  date = "Fecha?",
  description = "Lorem ipsum dolor sit amet consectetur adipisicing elit. Blanditiis molestiae debitis quidem pariatur possimus consequuntur, soluta velit eos similique! Sapiente quas accusantium id fuga dignissimos?",
} = Astro.props;
---

<article
  class="border-purple max-w-[40ch] min-w-[30ch] rounded-[10px] border bg-[#1d1e26] p-4 shadow-[0px_0px_3px_rgba(189,147,249,0.5)] transition-all duration-200 ease-in-out hover:shadow-[1px_2px_10px_rgba(189,147,249,0.5)]"
>
  <div class="m-0 flex flex-wrap gap-[0.3em]">
    {tags.map((tag) => <Tag>{tag}</Tag>)}
  </div>
  <slot name="image" />
  <h3
    class="text-green mt-2 mb-0 font-sans text-2xl font-bold before:content-none"
  >
    {title}
  </h3>
  <slot name="subtitle" />
  <p class="font-header text-cyan m-0 text-[0.7rem]">{date}</p>
  <p class="last:mb-0">{description}</p>
  <slot />
</article>

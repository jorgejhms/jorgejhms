---
const menu = [
  { url: "/", text: "01. inicio" },
  { url: "/about", text: "02. acerca de mi" },
  // { url: '/portfolio', text: '03. portafolio'},
  { url: "/works", text: "03. mi experiencia" },
  // { url: '/works', text: '04. mi experiencia'}
  // { url: '#', text: '05. blog'},
  // { url: '#', text: '06. contáctame'}
];
---

<div class="flex items-center justify-between">
  <div>
    <h1
      id="logo_title"
      class="font-header text-green double my-[0.2em] text-left text-[clamp(2.2rem,1px+7vw,3.12rem)] italic underline transition-all duration-200 ease-in-out"
    >
      jorgejhms
    </h1>
    <h2
      id="tagline"
      class="font-header text-cyan text-left text-[0.8rem] font-light before:content-none"
    >
      Sociólogo y desarrollador web
    </h2>
  </div>

  <i
    class="fa-solid fa-bars text-text hover:text-green cursor-pointer transition-all duration-200 ease-in-out sm:!hidden"
    id="mobile-menu-icon"></i>
</div>

<div
  class="transparent-bg absolute top-0 left-0 hidden h-screen w-screen place-items-center p-0"
  id="mobile-menu-wrapper"
>
  <p
    id="mobile-menu-close-button"
    class="font-header absolute top-8 right-8 cursor-pointer text-[0.9rem]"
  >
    <i class="fa-solid fa-xmark"></i> Cerrar
  </p>

  <nav>
    <ul id="mobile-menu" class="font-header flex list-none flex-col gap-4 p-0">
      {
        menu.map((item) => (
          <li>
            <a href={item.url}>{item.text}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<nav>
  <ul
    id="desktop-menu"
    class="font-header mt-[50%] hidden list-none flex-col gap-5 text-xl sm:flex"
  >
    {
      menu.map((item) => (
        <li>
          <a href={item.url}>{item.text}</a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const mobileMenuIcon = document.getElementById("mobile-menu-icon");
  const closeButton = document.getElementById("mobile-menu-close-button");
  const mobileMenuWrapper = document.getElementById("mobile-menu-wrapper");

  mobileMenuIcon.onclick = () => {
    mobileMenuWrapper.style.display = "grid";
  };

  closeButton.onclick = () => {
    mobileMenuWrapper.style.display = "none";
  };
</script>

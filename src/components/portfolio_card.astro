---
import Button from "../components/button.astro";
import Card from "../components/card.astro";
import imgFallback from "../../public/media/img_fallback.png";
const {
  title,
  date,
  description,
  tags,
  link = "#",
  img = imgFallback,
  alt = "Imagen de demo",
} = Astro.props;
---

<Card {title} {tags} {date} {description}>
  <figure slot="image" class="mt-2 aspect-video rounded-[10px]">
    <img src={img} {alt} class="object-cover object-[0%_0%]" />
  </figure>
  <Button href={link}>Ver demo</Button>
</Card>

---
import Card from "../components/card.astro";
const {
  position = "Posición?",
  workplace = "Empresa?",
  start_date = "Fecha?",
  end_date = "Fecha?",
  url = "#",
  tags = ["?"],
  description = "Lorem ipsum dolor sit amet consectetur adipisicing elit. Blanditiis molestiae debitis quidem pariatur possimus consequuntur, soluta velit eos similique! Sapiente quas accusantium id fuga dignissimos?",
} = Astro.props;

const date = start_date + " / " + end_date;
---

<Card title={position} {tags} {date} {description}>
  <p class="font-header my-[0.2em] font-black" slot="subtitle">
    <a href={url} class="text-purple">{workplace}</a>
  </p>
</Card>

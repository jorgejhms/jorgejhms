---
//src/layouts/base.astro
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import { AstroFont } from "astro-font";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <AstroFont
      config={[
        {
          src: [],
          name: "Fira Sans",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap",
          preload: true,
          display: "swap",
          selector: "body",
          fallback: "sans-serif",
        },
        {
          src: [],
          name: "JetBrains Mono",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap",
          preload: true,
          display: "swap",
          selector: "code, pre, .mono",
          fallback: "monospace",
        },
        {
          src: [],
          name: "Fira Code",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap",
          preload: true,
          display: "swap",
          selector: "code, pre, .code",
          fallback: "monospace",
        },
      ]}
    />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>
    <script
      src="https://kit.fontawesome.com/54d0e7e6da.js"
      crossorigin="anonymous"></script>
    <title>{title}</title>
  </head>
  <body>
    <header
      id="header"
      class="transparent-bg border-green sticky top-0 z-10 min-h-full border-b p-4 transition-all duration-200 ease-in-out sm:fixed sm:min-h-screen sm:w-[20rem] sm:border-r sm:border-b-0"
    >
      <Header />
    </header>

    <main class="mx-auto w-full max-w-[65rem] p-4 sm:ml-[20rem]">
      <slot />
    </main>

    <footer
      class="border-green bg-bg fixed bottom-0 z-10 w-full border-t py-2 text-center text-[0.8rem]"
    >
      <Footer />
    </footer>
  </body>
</html>
<script>
  const mobile = window.matchMedia("(max-width: 640px)");

  window.onscroll = function () {
    scrollFunction(mobile);
  };

  function scrollFunction(viwport) {
    if (viwport.matches) {
      if (
        document.body.scrollTop > 50 ||
        document.documentElement.scrollTop > 50
      ) {
        document.getElementById("logo_title").style.fontSize = "1.2rem";
        document.getElementById("header").style.padding = "0.4em";
        document.getElementById("tagline").style.display = "none";
      } else {
        document.getElementById("logo_title").style.fontSize = "";
        document.getElementById("header").style.padding = "";
        document.getElementById("tagline").style.display = "";
      }
    }
  }
</script>

---
//src/layouts/base.astro
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";
import { AstroFont } from "astro-font";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <AstroFont
      config={[
        {
          src: [],
          name: "Fira Sans",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap",
          preload: true,
          display: "swap",
          selector: "body",
          fallback: "sans-serif",
        },
        {
          src: [],
          name: "JetBrains Mono",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap",
          preload: true,
          display: "swap",
          selector: "code, pre, .mono",
          fallback: "monospace",
        },
        {
          src: [],
          name: "Fira Code",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap",
          preload: true,
          display: "swap",
          selector: "code, pre, .code",
          fallback: "monospace",
        },
      ]}
    />
    <script
      is:inline
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script
      is:inline
      src="https://kit.fontawesome.com/54d0e7e6da.js"
      crossorigin="anonymous"></script>
    <title>{title}</title>
  </head>
  <body>
    <!-- Top Navigation -->
    <header class="relative z-50 w-full">
      <Navigation />
    </header>

    <!-- Main Content -->
    <main class="w-full">
      <slot />
    </main>
  </body>
</html>

---
import Base from "../layouts/base.astro";
import { getEntry } from "astro:content";

const profile = await getEntry("about", "profile");

if (!profile) {
  throw new Error("Profile not found");
}

const { name, bio, image, imageRetina, imageCaption, education, skills } =
  profile.data;
---

<Base title="acerca de mi | jorgejhms.net" description={`Acerca de ${name}`}>
  <h2>acerca de mi</h2>
  <div class="sm:grid sm:grid-cols-2 sm:gap-4">
    <figure class="max-w-80">
      <img
        src={image}
        alt={`Foto de ${name}`}
        srcset={`${image} 1x, ${imageRetina} 2x`}
        class="rounded-full"
      />
      {imageCaption && <figcaption>{imageCaption}</figcaption>}
    </figure>
    <div>
      <p set:html={bio} />
    </div>
  </div>

  {
    education && education.length > 0 && (
      <>
        <h3>mis grados</h3>
        <div class="sm:grid sm:grid-cols-2 sm:gap-4">
          {education.map((edu) => (
            <div>
              <figure class="h-[150px] p-4">
                <img
                  src={edu.logo}
                  alt={`Logo de ${edu.institution}`}
                  loading="lazy"
                />
              </figure>
              <p class="centered">{edu.degree.toLowerCase()}</p>
              <p class="centered">
                <mark>{edu.year}</mark>
              </p>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    skills && skills.length > 0 && (
      <>
        <h3>mis skills</h3>
        <div class="flex justify-around gap-4 text-2xl">
          {skills.map((skill) => (
            <i class={skill.icon} title={skill.name} />
          ))}
        </div>
      </>
    )
  }
</Base>

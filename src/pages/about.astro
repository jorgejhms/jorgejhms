---
import Base from "../layouts/base.astro";
import { getEntry } from "astro:content";

const profile = await getEntry("about", "profile");

if (!profile) {
  throw new Error("Profile not found");
}

const { name, bio, image, imageRetina, imageCaption, education, skills } =
  profile.data;
---

<Base title="acerca de mi | jorgejhms.net" description={`Acerca de ${name}`}>
  <section class="section-spacing">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-12 space-y-4">
        <h2 class="neon-text font-mono text-3xl font-bold md:text-4xl">
          <span class="text-primary mr-2">&gt;</span> Acerca de mí
        </h2>
        <p class="text-muted font-mono text-sm">
          <span class="text-comment">//</span> Conoce un poco más sobre mi trayectoria
        </p>
      </div>

      <div class="sm:grid sm:grid-cols-2 sm:gap-12 items-center">
        <figure class="max-w-xs mx-auto relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-full blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
          <img
            src={image}
            alt={`Foto de ${name}`}
            srcset={`${image} 1x, ${imageRetina} 2x`}
            class="relative rounded-full border-2 border-primary/50 shadow-neon-green"
          />
          {imageCaption && <figcaption class="mt-4 font-mono text-sm text-center text-muted">{imageCaption}</figcaption>}
        </figure>
        
        <div class="mt-8 sm:mt-0 space-y-4">
          <div class="prose prose-invert prose-p:text-foreground/80 font-mono text-sm md:text-base leading-relaxed">
             <p set:html={bio} />
          </div>
        </div>
      </div>

      {
        education && education.length > 0 && (
          <div class="mt-16">
            <h3 class="neon-text-purple font-mono text-2xl font-bold mb-8 flex items-center">
              <span class="text-secondary mr-2">#</span> Mis Grados
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {education.map((edu) => (
                <div class="bg-surface border border-border p-6 rounded-lg hover:border-primary/50 transition-colors group">
                  <figure class="h-[100px] flex items-center justify-center p-4 mb-4 bg-elevated/30 rounded">
                    <img
                      src={edu.logo}
                      alt={`Logo de ${edu.institution}`}
                      loading="lazy"
                      class="max-h-full w-auto object-contain filter grayscale group-hover:grayscale-0 transition-all"
                    />
                  </figure>
                  <div class="text-center">
                     <p class="font-bold text-foreground mb-1">{edu.degree}</p>
                     <p class="text-sm font-mono text-primary">
                        <span class="text-muted mr-1">[</span>{edu.year}<span class="text-muted ml-1">]</span>
                     </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        skills && skills.length > 0 && (
          <div class="mt-16">
            <h3 class="neon-text-cyan font-mono text-2xl font-bold mb-8 flex items-center">
               <span class="text-accent mr-2">$</span> Mis Skills
            </h3>
            <div class="flex flex-wrap justify-center gap-6 text-3xl">
              {skills.map((skill) => (
                <div class="bg-surface p-4 rounded-lg border border-border hover:border-accent hover:text-accent hover:shadow-neon-cyan transition-all duration-300 group relative">
                  <i class={`${skill.icon}`} />
                  <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs font-mono opacity-0 group-hover:opacity-100 transition-opacity bg-elevated px-2 py-1 rounded whitespace-nowrap border border-border">
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

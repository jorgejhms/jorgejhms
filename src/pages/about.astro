---
import Base from "@layouts/base.astro";
import { getEntry } from "astro:content";

const profile = await getEntry("about", "profile");

if (!profile) {
  throw new Error("Profile not found");
}

const { name, bio, image, imageRetina, imageCaption, education, skills } =
  profile.data;
---

<Base title="acerca de mi | jorgejhms.net" description={`Acerca de ${name}`}>
  <section class="section-spacing">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-12 space-y-4">
        <h2 class="neon-text font-mono text-3xl font-bold md:text-4xl">
          <span class="text-primary mr-2">&gt;</span> Acerca de mí
        </h2>
        <p class="text-muted font-mono text-sm">
          <span class="text-comment">//</span> Conoce un poco más sobre mi trayectoria
        </p>
      </div>

      <div class="items-center sm:grid sm:grid-cols-2 sm:gap-12">
        <figure class="group relative mx-auto max-w-xs">
          <div
            class="from-primary to-secondary absolute -inset-1 rounded-full bg-gradient-to-r opacity-25 blur transition duration-1000 group-hover:opacity-75 group-hover:duration-200"
          >
          </div>
          <img
            src={image}
            alt={`Foto de ${name}`}
            srcset={`${image} 1x, ${imageRetina} 2x`}
            class="border-primary/50 shadow-neon-green relative rounded-full border-2"
          />
          {
            imageCaption && (
              <figcaption class="text-muted mt-4 text-center font-mono text-sm">
                {imageCaption}
              </figcaption>
            )
          }
        </figure>

        <div class="mt-8 space-y-4 sm:mt-0">
          <div
            class="prose prose-invert prose-p:text-foreground/80 font-mono text-sm leading-relaxed md:text-base"
          >
            <p set:html={bio} />
          </div>
        </div>
      </div>

      {
        education && education.length > 0 && (
          <div class="mt-16">
            <h3 class="neon-text-purple mb-8 flex items-center font-mono text-2xl font-bold">
              <span class="text-secondary mr-2">#</span> Mis Grados
            </h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              {education.map((edu) => (
                <div class="bg-surface border-border hover:border-primary/50 group rounded-lg border p-6 transition-colors">
                  <figure class="bg-elevated/30 mb-4 flex h-[100px] items-center justify-center rounded p-4">
                    <img
                      src={edu.logo}
                      alt={`Logo de ${edu.institution}`}
                      loading="lazy"
                      class="max-h-full w-auto object-contain grayscale filter transition-all group-hover:grayscale-0"
                    />
                  </figure>
                  <div class="text-center">
                    <p class="text-foreground mb-1 font-bold">{edu.degree}</p>
                    <p class="text-primary font-mono text-sm">
                      <span class="text-muted mr-1">[</span>
                      {edu.year}
                      <span class="text-muted ml-1">]</span>
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        skills && skills.length > 0 && (
          <div class="mt-16">
            <h3 class="neon-text-cyan mb-8 flex items-center font-mono text-2xl font-bold">
              <span class="text-accent mr-2">$</span> Mis Skills
            </h3>
            <div class="flex flex-wrap justify-center gap-6 text-3xl">
              {skills.map((skill) => (
                <div class="bg-surface border-border hover:border-accent hover:text-accent hover:shadow-neon-cyan group relative rounded-lg border p-4 transition-all duration-300">
                  <i class={`${skill.icon}`} />
                  <span class="bg-elevated border-border absolute -bottom-8 left-1/2 -translate-x-1/2 rounded border px-2 py-1 font-mono text-xs whitespace-nowrap opacity-0 transition-opacity group-hover:opacity-100">
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

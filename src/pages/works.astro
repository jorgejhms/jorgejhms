---
import Base from "../layouts/base.astro";
import WorkCard from "../components/work_card.astro";
import { getCollection } from "astro:content";

const experience = await getCollection("experience");
experience.sort(
  (a, b) =>
    new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime(),
);
---

<Base title="mi experiencia | jorgejhms" description="Mi experiencia laboral">
  <section class="section-spacing">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-12 space-y-4">
        <h2 class="neon-text font-mono text-3xl font-bold md:text-4xl">
          <span class="text-primary mr-2">&gt;</span> Experiencia
        </h2>
        <p class="text-muted font-mono text-sm">
          <span class="text-comment">//</span> Cronología de mi trayectoria profesional
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-2">
        {
          experience.map((item) => (
            <WorkCard
              position={item.data.position}
              workplace={item.data.workplace}
              start_date={item.data.startDate}
              end_date={item.data.endDate}
              url={item.data.url}
              tags={item.data.tags}
              description={item.data.description}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>

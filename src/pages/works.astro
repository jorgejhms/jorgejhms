---
import Base from "@layouts/base.astro";
import WorkCard from "@components/WorkCard.astro";
import { parse } from "yaml";
import { readFileSync } from "fs";
import { resolve } from "path";

// Load experience data from YAML
const experiencePath = resolve("./src/data/experience.yaml");
const experienceYaml = readFileSync(experiencePath, "utf-8");
const allExperience = parse(experienceYaml) as Array<{
  id: string;
  position: string;
  workplace: string;
  startDate: string;
  endDate: string;
  url: string;
  tags: string[];
  description: string;
  featured?: boolean;
}>;

// Filter by featured (default true if not specified, to show all by default)
// User can toggle to show only featured
const showOnlyFeatured = false; // Change to true to show only featured by default
const experience = showOnlyFeatured
  ? allExperience.filter((item) => item.featured === true)
  : allExperience;

// Sort by start date (most recent first)
experience.sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime(),
);
---

<Base title="mi experiencia | jorgejhms" description="Mi experiencia laboral">
  <section class="section-spacing">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-12 space-y-4">
        <h2 class="neon-text font-mono text-3xl font-bold md:text-4xl">
          <span class="text-primary mr-2">&gt;</span> Experiencia
        </h2>
        <p class="text-muted font-mono text-sm">
          <span class="text-comment">//</span> Cronología de mi trayectoria profesional
        </p>
        <p class="text-foreground/70 text-sm">
          Total de {allExperience.length} posiciones • Mostrando {
            experience.length
          }
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-2">
        {
          experience.map((item) => (
            <WorkCard
              position={item.position}
              workplace={item.workplace}
              start_date={item.startDate}
              end_date={item.endDate}
              url={item.url}
              tags={item.tags}
              description={item.description}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
